{
  "manifest_version": 3,
  "key": "",
  "name": "Dutch Live Subtitle Translator - Daily Logging",
  "description": "Capture tab audio, transcribe Dutch locally, and show translated subtitles in a popup window.",
  "version": "0.5.0",
  "permissions": [
    "activeTab",
    "tabs",
    "tabCapture",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Open Dutch Subtitles"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:* ws://localhost:* http://127.0.0.1:* http://localhost:*;"
  }
}
