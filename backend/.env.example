# ASR
ASR_DEVICE=auto
ASR_MODEL=large-v3-turbo
# Optional per-mode overrides (only one model is loaded unless explicitly configured)
FAST_ASR_MODEL=
BALANCED_ASR_MODEL=
QUALITY_ASR_MODEL=
ASR_COMPUTE_TYPE=
ASR_LANGUAGE=nl
ASR_BEAM_SIZE=2
FAST_ASR_BEAM_SIZE=1
BALANCED_ASR_BEAM_SIZE=2
QUALITY_ASR_BEAM_SIZE=3
ASR_CONDITION_ON_PREVIOUS_TEXT=0
ASR_WORD_TIMESTAMPS=1
PARTIAL_ASR_WORD_TIMESTAMPS=0
FINAL_ASR_WORD_TIMESTAMPS=1
ASR_VAD_FILTER=1
ASR_VAD_MIN_SILENCE_MS=300
ASR_VAD_MIN_SPEECH_MS=150
ASR_VAD_SPEECH_PAD_MS=200
ASR_NO_SPEECH_THRESHOLD=0.6
ASR_COMPRESSION_RATIO_THRESHOLD=2.4
# Optional per-video ASR hint. Empty by default to avoid domain bias.
ASR_INITIAL_PROMPT=

# Subtitle layout
SUBTITLE_MAX_DURATION_SECONDS=6
SUBTITLE_MIN_DURATION_SECONDS=0.8
SUBTITLE_MAX_CHARACTERS=84
SUBTITLE_MAX_LINE_CHARACTERS=42
SUBTITLE_MAX_LINES=2
SUBTITLE_BREAK_SILENCE_MS=500

# Stable sentence construction with an optional partial source-language preview.
SENTENCE_MODE=1
PARTIAL_ASR_ENABLED=1
PARTIAL_ASR_INTERVAL_MS=900
PARTIAL_ASR_MAX_SECONDS=1.8
PIPELINE_QUEUE_MAX_SEGMENTS=3
PIPELINE_MERGE_MAX_SECONDS=12
TRANSLATION_QUEUE_MAX_ITEMS=4
DROP_FILLERS=1
GLOSSARY_ENABLED=0
GLOSSARY_PATH=config/glossary.tsv
MIN_SPEECH_SECONDS=0.35
MIN_FINAL_WORDS=4
SENTENCE_MAX_BUFFER_WORDS=28
SENTENCE_MAX_BUFFER_CHARS=220
FAST_MAX_SEGMENT_SECONDS=2.8
BALANCED_MAX_SEGMENT_SECONDS=5.5
QUALITY_MAX_SEGMENT_SECONDS=6.5
FAST_END_SILENCE_SECONDS=0.35
BALANCED_END_SILENCE_SECONDS=0.65
QUALITY_END_SILENCE_SECONDS=0.80
PRE_ROLL_SECONDS=0.15

# Translation
# Prepare models with: backend/scripts/prepare_translation_ct2.sh [m2m100|nllb]
TRANSLATION_ENGINE=auto
TRANSLATION_MODEL_FAMILY=nllb
TRANSLATION_MODEL=models/nllb-200-distilled-600m-ct2
TRANSLATION_TOKENIZER=facebook/nllb-200-distilled-600M
TRANSFORMERS_TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
TRANSLATION_DEVICE=auto
TRANSLATION_COMPUTE_TYPE=
TRANSLATION_BEAM_SIZE=1
TRANSLATION_CACHE_ITEMS=4096
LOCAL_MODELS_ONLY=1

# Export
EXPORT_ALIGNMENT_ENGINE=live
WHISPERX_ASR_MODEL=large-v3-turbo

# Extension / host
DUTCH_SUBTITLE_EXTENSION_ID=
DUTCH_SUBTITLE_EXTENSION_PUBLIC_KEY=
DUTCH_SUBTITLE_FIREFOX_EXTENSION_ID=dutch-subtitle-translator@polatozgur111.local

# Logging / history
BACKEND_LOG_DIR=logs
BACKEND_LOG_PREFIX=backend
LOG_LEVEL=INFO
LOG_TRANSCRIPT_TEXT=0
SESSION_HISTORY_ENABLED=1
SESSION_HISTORY_DB=logs/session-history.sqlite3
