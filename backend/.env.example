# RTX 3060 recommended ASR for live latency.
# Use ASR_MODEL=medium only when accuracy matters more than delay.
DUTCH_SUBTITLE_EXTENSION_ID=
DUTCH_SUBTITLE_EXTENSION_PUBLIC_KEY=

ASR_DEVICE=cuda
ASR_MODEL=small
ASR_COMPUTE_TYPE=float16
ASR_LANGUAGE=nl
ASR_BEAM_SIZE=2
FAST_ASR_BEAM_SIZE=1
BALANCED_ASR_BEAM_SIZE=2
QUALITY_ASR_BEAM_SIZE=3
ASR_CONDITION_ON_PREVIOUS_TEXT=0
# Optional per-video ASR hint. Empty by default to avoid domain bias.
# Example: ASR_INITIAL_PROMPT=Dit is Nederlandstalige audio over voetbal en clubs in België.
ASR_INITIAL_PROMPT=

# Stable sentence construction with optional partial Dutch preview.
SENTENCE_MODE=1
PARTIAL_ASR_ENABLED=1
PARTIAL_ASR_INTERVAL_MS=900
PARTIAL_ASR_MAX_SECONDS=1.8
PIPELINE_QUEUE_MAX_SEGMENTS=3
# Keep at 0 unless profiling proves growing CPU-only work needs process isolation.
PIPELINE_PROCESS_POOL_WORKERS=0
DROP_FILLERS=1
GLOSSARY_ENABLED=0
GLOSSARY_PATH=config/glossary.tsv
MIN_SPEECH_SECONDS=0.35
MIN_FINAL_WORDS=4
SENTENCE_MAX_BUFFER_WORDS=28
SENTENCE_MAX_BUFFER_CHARS=220
FAST_MAX_SEGMENT_SECONDS=2.8
BALANCED_MAX_SEGMENT_SECONDS=5.5
QUALITY_MAX_SEGMENT_SECONDS=6.5
FAST_END_SILENCE_SECONDS=0.35
BALANCED_END_SILENCE_SECONDS=0.65
QUALITY_END_SILENCE_SECONDS=0.80
PRE_ROLL_SECONDS=0.15

# Preferred translation path: run backend/scripts/prepare_translation_ct2.sh once.
TRANSLATION_ENGINE=auto
TRANSLATION_MODEL=models/opus-mt-nl-en-ct2
TRANSLATION_TOKENIZER=Helsinki-NLP/opus-mt-nl-en
TRANSFORMERS_TRANSLATION_MODEL=Helsinki-NLP/opus-mt-nl-en
TRANSLATION_DEVICE=cpu
TRANSLATION_COMPUTE_TYPE=int8
TRANSLATION_BEAM_SIZE=1
TRANSLATION_CACHE_ITEMS=4096

# Daily logs are written under backend/logs/.
BACKEND_LOG_DIR=logs
BACKEND_LOG_PREFIX=backend
LOG_LEVEL=INFO
# Default 0 avoids storing subtitle/translation text in logs. Set to 1 only for debugging precision problems.
LOG_TRANSCRIPT_TEXT=0
# Local SQLite session/subtitle history. Disable if transcript text must not be persisted.
SESSION_HISTORY_ENABLED=1
SESSION_HISTORY_DB=logs/session-history.sqlite3
